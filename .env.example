# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_...) ou a antiga "service_role". NUNCA exponha no navegador.
SUPABASE_SECRET_KEY=
# Chave publicável (sb_publishable_...) ou a antiga "anon". Usada só no servidor.
SUPABASE_PUBLISHABLE_KEY=
# Único domínio aceito no cadastro (sem @)
ALLOWED_EMAIL_DOMAIN=vanderhulst.com.br
# OWNER criado automaticamente no primeiro acesso (senha inicial provisória: troca obrigatória)
OWNER_EMAIL=luan.godoi@vanderhulst.com.br
OWNER_NOME=Luan Godoi
OWNER_DEPARTAMENTO=QUALIDADE
OWNER_SENHA_INICIAL=
# Recuperação de emergência da senha do OWNER: defina "sim", faça Redeploy e depois remova
# OWNER_REDEFINIR_SENHA=
# Opcional: falhas de login por IP em 15 min antes de bloquear (padrão 5, mínimo 5)
# LIMITE_FALHAS_POR_IP=5
# Opcional: espaço máximo (MB) antes de apagar os PDFs mais antigos (padrão 850)
# LIMITE_ARMAZENAMENTO_MB=850
# Opcional: fuso usado na data de emissão do laudo
# FUSO_HORARIO=America/Sao_Paulo

# Opcional: envio automático ao OneDrive/SharePoint (ver README)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# ONEDRIVE_PASTA_LINK=
