# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_...) ou a antiga "service_role". NUNCA exponha no navegador.
SUPABASE_SECRET_KEY=
# Senha única para entrar no site (obrigatória)
SENHA_ACESSO=
# Opcional: espaço máximo (MB) antes de apagar os PDFs mais antigos (padrão 850)
# LIMITE_ARMAZENAMENTO_MB=850
# Opcional: fuso usado na data de emissão do laudo
# FUSO_HORARIO=America/Sao_Paulo

# Opcional: envio automático ao OneDrive/SharePoint (ver README)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# ONEDRIVE_PASTA_LINK=
